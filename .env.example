# Copy this file to ".env" (Windows: copy .env.example .env) and fill in your key.
# NEVER commit the real .env file or share your key.

# Your Anthropic API key (get one from https://console.anthropic.com/).
# Leave as-is (or blank) to run in clearly-labelled DEMO mode.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: model name to use. Defaults to claude-sonnet-5-5 if not set.
# ANTHROPIC_MODEL=claude-sonnet-5-5
